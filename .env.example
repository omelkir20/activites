# Copier en .env :  cp .env.example .env   (le fichier .env n'est JAMAIS commité)

# --- PostgreSQL (service "db" de Docker Compose) ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change_me
POSTGRES_DB=portfolio
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Connexion utilisée par Prisma / les tests depuis la machine hôte ---
DATABASE_URL=postgresql://portfolio:change_me@localhost:5432/portfolio?schema=public

# --- API Express ---
PORT=4000
CORS_ORIGIN=http://localhost:3000
CONTACT_RATE_LIMIT_MAX=5
CONTACT_RATE_LIMIT_WINDOW_MS=60000

# --- Tag des images Docker (Jenkins y met le Git SHA court) ---
IMAGE_TAG=latest
